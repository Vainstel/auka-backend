# Copy to .env.relay. Only for whoever runs the public push relay for the official app.

# IP or domain of this relay; goes into its self-signed certificate.
PUBLIC_HOST=203.0.113.20
# self-signed (default), or off behind a reverse proxy with a real certificate.
TLS_MODE=self-signed
RELAY_PORT=8444

# Same value on every relay, so a handle from one works on the others.
# Make one with: head -c 32 /dev/urandom | base64
RELAY_SECRET=

# The Apple key of the account that publishes the app.
APNS_KEY_BASE64=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=io.vainslab.auka
APNS_CRITICAL_RING=false
