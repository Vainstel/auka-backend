# Copy to .env. Everything except PUBLIC_HOST is optional.

# IP or domain clients connect to; goes into the self-signed certificate on first start.
PUBLIC_HOST=203.0.113.10
SERVER_NAME=Auka
# self-signed (default) or off, when a reverse proxy terminates TLS. Then also set TRUST_PROXY=true.
TLS_MODE=self-signed
TRUST_PROXY=false
HOST_PORT=8443
# Set to 127.0.0.1 behind a local reverse proxy, or X-Forwarded-For can be spoofed from outside.
HOST_BIND=0.0.0.0

# Registration needs this code. The server refuses to start without one,
# unless ALLOW_OPEN_REGISTRATION=true lets anyone who finds it register.
INVITE_CODE=change-me
ALLOW_OPEN_REGISTRATION=false

# Email confirmation and the login code are on only when SMTP_HOST is set.
# Without it the server is single-factor: login and password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Auka
MAIL_MAX_PER_DAY=200

# Push notifications. By default they go through the public Auka relays and need nothing here.
# Set PUSH_RELAYS to use other relays, or "none" to switch them off. Format, comma separated:
#   https://relay.example.com  or  https://203.0.113.20:8444|<SHA-256 fingerprint of its self-signed certificate>
PUSH_RELAYS=

# Your own Apple key instead of the relays (only if you build and publish the app yourself).
# APNS_KEY_BASE64 is the .p8 file encoded with base64.
APNS_KEY_BASE64=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
# true only after Apple grants the Critical Alerts entitlement to the app.
APNS_CRITICAL_RING=false

# Delete messages from the server after N days; 0 keeps them forever.
MESSAGE_RETENTION_DAYS=0

# Photos and files: stored encrypted, deleted after FILE_TTL_HOURS.
# When FILE_STORAGE_MB is used up, new uploads fail until old files expire.
FILE_STORAGE_MB=500
FILE_TTL_HOURS=168
FILE_MAX_MB=15
